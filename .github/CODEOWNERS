/internal/session/          @paxlabs-inc/ion-maintainers
/internal/memory/           @paxlabs-inc/ion-maintainers
/internal/work/             @paxlabs-inc/ion-maintainers
/internal/scheduler/        @paxlabs-inc/ion-maintainers
/migrations/                @paxlabs-inc/ion-maintainers

# Control plane and generated protocol
/internal/controlplane/     @paxlabs-inc/ion-maintainers
/ui/shared/                 @paxlabs-inc/ion-maintainers

# Operator clients
/ui/web/                    @paxlabs-inc/ion-web
/ui/tui/                    @paxlabs-inc/ion-web

# Rust vector-search sidecar
/hnsw-service/              @paxlabs-inc/ion-maintainers

# Deployment, packaging, and infrastructure
