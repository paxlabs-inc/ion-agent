# Copy to deploy/compose/.env and edit.

# Public site address handled by Caddy.
#   - A real domain (e.g. ion.example.com) enables automatic HTTPS.
#   - "localhost" or "https://localhost" uses Caddy's internal self-signed CA.
ION_SITE_ADDRESS=localhost

# Exact browser origin. For a public domain, use https:// and the same hostname
# as ION_SITE_ADDRESS.
ION_WEB_ORIGIN=https://localhost

# Required operator login. Set exactly one password variable. Use a generated,
# sealed value in production; do not commit the populated .env file.
ION_AUTH_USERNAME=operator
ION_AUTH_PASSWORD=
# ION_AUTH_PASSWORD_HASH='$argon2id$v=19$m=65536,t=3,p=2$...'

# Structured public-web research. Tavily is primary when this key is set;
# ION_SEARCH_ENDPOINT remains the SearXNG fallback.
TAVILY_API_KEY=
# ION_TAVILY_SEARCH_ENDPOINT=https://api.tavily.com/search
# ION_SEARCH_ENDPOINT=https://browsingmachine.com/

# Ion image to run. Pin to a released tag in production.
ION_IMAGE=ghcr.io/paxlabs-inc/ion-agent:latest

# Optional Office Studio override:
#   docker compose -f docker-compose.yml -f docker-compose.office.yml up -d
# Generate this value with `openssl rand -hex 32` and keep it sealed.
ION_OFFICE_JWT_SECRET=
ION_OFFICE_IMAGE=onlyoffice/documentserver:8.2.0
