# Copy to docker/.env and adjust as needed.
# docker compose reads this automatically.

# Data directory inside the container (persisted via the ion-data volume).
ION_DATA_DIR=/data

# Web operator listen address. Plain HTTP must bind loopback.
ION_WEB_LISTEN=127.0.0.1:4174

# Optional on loopback and required whenever ION_WEB_ORIGIN is remote.
ION_WEB_ORIGIN=
ION_AUTH_USERNAME=
ION_AUTH_PASSWORD=
# ION_AUTH_PASSWORD_HASH='$argon2id$v=19$m=65536,t=3,p=2$...'

# Tavily-backed structured research with SearXNG fallback.
TAVILY_API_KEY=
# ION_TAVILY_SEARCH_ENDPOINT=https://api.tavily.com/search
# ION_SEARCH_ENDPOINT=https://browsingmachine.com/

# First-run initialization (development convenience). Set to 0 for production
# and run `ion init` yourself against a host-protected key source.
ION_AUTO_INIT=1

# Development-only file KEK. NEVER enable in production.
ION_DEV_FILE_KEK=1

# Image tag to build/run.
ION_IMAGE=ion:local
